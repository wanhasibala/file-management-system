            "method": "GET",
            "url": { "raw": "{{base_url}}/api/v1/files/1/preview", "host": ["{{base_url}}"], "path": ["api", "v1", "files", "1", "preview"] }
          }
        },
        {
          "name": "Upload Document (Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "title", "value": "Flight Safety Report 2026", "type": "text" },
                { "key": "department_id", "value": "1", "type": "text" },
                { "key": "folder_id", "value": "1", "type": "text" },
                { "key": "description", "value": "Monthly safety auditing records", "type": "text" },
                { "key": "file", "type": "file", "src": "" }
              ]
            },
            "url": { "raw": "{{base_url}}/api/v1/files", "host": ["{{base_url}}"], "path": ["api", "v1", "files"] }
          }
        },
        {
          "name": "Delete File (Admin)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/v1/files/1", "host": ["{{base_url}}"], "path": ["api", "v1", "files", "1"] }
          }
        }
      ]
    },
