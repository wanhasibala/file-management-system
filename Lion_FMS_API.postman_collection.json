        }
      ]
    },
    {
      "name": "Files & Documents",
      "item": [
        {
          "name": "Search & Filter Files",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v1/files?search=report&department_id=1&type=pdf&sort_by=created_at&sort_order=desc",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "files"],
              "query": [
                { "key": "search", "value": "report" },
                { "key": "department_id", "value": "1" },
                { "key": "type", "value": "pdf" },
                { "key": "sort_by", "value": "created_at" },
                { "key": "sort_order", "value": "desc" }
              ]
            }
          }
        },
        {
          "name": "Get File Detail",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
